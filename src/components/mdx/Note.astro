---
interface Props {
  variant?: 'success' | 'info' | 'warning'
  title?: string
  id?: string
}

const colors = {
  success: 'bg-drac-green/10 border-drac-green text-drac-green',
  info: 'bg-drac-cyan/10 border-drac-cyan text-drac-cyan',
  warning: 'bg-drac-orange/10 border-drac-orange text-drac-orange',
}
const defaultTitles = { success: undefined, info: 'Info', warning: 'Warning' }
const { variant = 'info', title: titleProp, id } = Astro.props
const title = titleProp ?? defaultTitles[variant]
---

<div class="-mx-0.5" id={id}>
  <div
    class:list={[
      'note -mx-2 my-7 rounded-xl border-x-2 px-4 py-7 md:-mx-6 md:px-10',
      colors[variant],
    ]}
  >
    {title && <p class="font-display text-lg font-bold">{title}</p>}
    <slot />
  </div>
</div>
