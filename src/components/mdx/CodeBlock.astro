---
const {
  class: className,
  'data-language': languageFromMdx,
  'data-wrapper': noWrapper,
  'data-theme': theme,
  'data-title': title,
  id,
  ...rest
} = Astro.props

const languageNames: Record<string, string> = {
  js: 'javascript',
  jsx: 'jsx',
  ts: 'typescript',
  tsx: 'tsx',
  md: 'markdown',
}
const language = languageNames[languageFromMdx] ?? languageFromMdx
const plain = !theme || noWrapper
const preClass = [className, 'my-0!']
---

{
  plain ? (
    <pre
      {...rest}
      id={id}
      class:list={preClass}
      data-language={languageFromMdx}
      data-theme={theme}
      data-wrapper={noWrapper}
    >
      <slot />
    </pre>
  ) : (
    <>
      {title && (
        <div class="code-block-title font-display text-drac-base -mb-[1.7rem] rounded-sm rounded-b-none text-sm font-bold">
          <span class="bg-drac-purple inline-block rounded-sm rounded-b-none px-3 py-0.5">
            {title}
          </span>
        </div>
      )}
      <div
        id={id}
        class="code-block bg-drac-base ring-drac-purple relative -mx-2 my-7 overflow-hidden rounded-sm p-2 pb-0! ring-2 md:-mx-6 md:px-6 md:py-4"
      >
        <div class="font-display mb-4 flex items-center space-x-2 text-sm font-bold tracking-wide">
          <div class="text-drac-purple text-sm uppercase sm:text-sm">{language}</div>
          <div class="flex-1" />
          <button
            type="button"
            class="bg-drac-purple font-display text-drac-base focus:ring-drac-pink cursor-pointer rounded-sm px-2 text-center text-sm font-bold tracking-wider transition focus:ring-2 focus:ring-offset-2 focus:ring-offset-current focus:outline-hidden"
            data-copy-code
          >
            <span class="inline-grid overflow-hidden">
              <span class="col-start-1 row-start-1 transition-transform" data-copy-label>
                copy
              </span>
              <span
                class="col-start-1 row-start-1 translate-y-full transition-transform"
                data-copied-label
              >
                copied
              </span>
            </span>
          </button>
        </div>
        <pre {...rest} class:list={preClass} data-language={languageFromMdx} data-theme={theme}>
          <slot />
        </pre>
      </div>
    </>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')) {
    if (button.dataset.ready === 'true') continue
    button.dataset.ready = 'true'
    button.addEventListener('click', async () => {
      const root = button.closest('.code-block')
      const pre = root?.querySelector<HTMLPreElement>('pre:not(.hidden)')
      if (!pre) return

      const code = pre.querySelector('code')
      const text = code
        ? Array.from(code.children)
            .map(line => (line as HTMLElement).innerText || '')
            .join('\n')
        : pre.innerText
      await navigator.clipboard.writeText(text)

      button.querySelector('[data-copy-label]')?.classList.add('-translate-y-full')
      button.querySelector('[data-copied-label]')?.classList.remove('translate-y-full')
      window.setTimeout(() => {
        button.querySelector('[data-copy-label]')?.classList.remove('-translate-y-full')
        button.querySelector('[data-copied-label]')?.classList.add('translate-y-full')
      }, 1500)
    })
  }
</script>
