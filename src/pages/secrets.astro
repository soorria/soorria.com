---
import { Settings } from '~/components/secrets/Settings'
import { getOgImage } from '~/utils/og'
import MainLayout from '../layouts/MainLayout.astro'
import PostLayout from '../layouts/PostLayout.astro'
---

<MainLayout
  title="Secret Stuff"
  description="Shhh... 🤫🤐"
  canonical="https://soorria.com/secrets"
  ogTitle="Secret Stuff"
  ogImage={getOgImage({ title: 'Nothing to see here...', subtitle: 'soorria.com' }).url}
>
  <PostLayout title="Secret Stuff">
    <Settings client:only="react" />
    <noscript><p class="text-center">This page needs JavaScript!</p></noscript>
  </PostLayout>
</MainLayout>
