---
import ProjectsShowcase from '~/components/projects/ProjectsShowcase'
import { featuredProjects } from '~/constants'
import { getAllFilesFrontMatter } from '~/lib/data'
import type { ProjectFrontMatter } from '~/types/project'
import { getOgImageForData } from '~/utils/og'
import MainLayout from '../../layouts/MainLayout.astro'
import PostLayout from '../../layouts/PostLayout.astro'

const description = "Things I've made. Some are more useful and cooler than others."
const aboveFold = [
  ...featuredProjects,
  'sizes',
  'clinically-relevant',
  'not-messenger',
  'aqrm',
  'wordle-score',
  'slidy',
  'fight-for-tribeland',
]
const order = (slug: string) => {
  const index = aboveFold.indexOf(slug)
  return index < 0 ? 100 : index
}
const projects = (await getAllFilesFrontMatter<ProjectFrontMatter>('projects')).sort(
  (a, b) => order(a.slug) - order(b.slug)
)
---

<MainLayout
  title="Projects"
  description={description}
  canonical="https://soorria.com/projects"
  ogTitle="Projects"
  ogImage={getOgImageForData('projects').url}
>
  <PostLayout title="Projects" description={description}>
    <ProjectsShowcase client:load projects={projects} />
  </PostLayout>
</MainLayout>
