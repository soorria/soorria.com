---
import { getOgImage } from '~/utils/og'
import ContentRenderer from '../components/mdx/ContentRenderer.astro'
import MainLayout from '../layouts/MainLayout.astro'
import PostLayout from '../layouts/PostLayout.astro'
---

<MainLayout
  title="What I Use"
  description="Stuff I use"
  canonical="https://soorria.com/uses"
  ogTitle="What I Use"
  ogType="article"
  ogImage={getOgImage({ title: 'Uses' }).url}
>
  <PostLayout title="What I Use">
    <div class="slide-in prose md:prose-lg mx-auto mt-6 mb-12">
      <ContentRenderer type="misc" slug="uses" />
      <div class="mx-auto mt-24! max-w-xs text-center text-sm">
        Check out other <code>uses</code> pages <a href="https://uses.tech">here</a>
      </div>
    </div>
  </PostLayout>
</MainLayout>
