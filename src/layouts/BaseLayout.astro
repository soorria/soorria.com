---
import '../styles/globals.css'
import '../styles/prose.css'

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogTitle?: string
  ogType?: 'website' | 'article'
  ogImage?: string
  publishedTime?: string
  modifiedTime?: string
  tags?: string[]
}

const siteTitle = 'Soorria Saruva - Full Stack Software Engineer'
const siteDescription = 'Full Stack Software Engineer'
const {
  title,
  description = siteDescription,
  canonical = 'https://soorria.com',
  ogTitle = title ?? siteTitle,
  ogType = 'website',
  ogImage = 'https://soorria.com/api/og?title=Soorria%20Saruva&subtitle=soorria.com',
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props

const documentTitle = title ? `${title} • Soorria Saruva` : siteTitle
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#282a36" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="Cl0BjsWegjV0EoEmhPMVdyI9qWoAdOwh5S-h37tEaao" />
    <meta name="msapplication-TileColor" content="#282a36" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/poppins-latin-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/poppins-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@soorriously" />
    <meta name="twitter:site" content="@soorriously" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{documentTitle}</title>

    <script
      is:inline
      defer
      data-domain="mooth.tech"
      data-api="/potato/api/event"
      src="/potato/js/script.js"></script>
  </head>
  <body
    class="bg-drac-base text-drac-content relative flex h-full min-h-screen flex-col overflow-y-auto"
  >
    <slot />
    <noscript>
      <style is:inline>
        .no-js-block {
          display: block !important;
        }
        .no-js-text {
          color: #f8f8f2 !important;
        }
        .no-js-hidden {
          display: none;
        }
      </style>
    </noscript>
  </body>
</html>
