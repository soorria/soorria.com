---
import {
  EmailIcon,
  GithubIconSolid,
  HeartIcon,
  LinkedinIconSolid,
  LinkIcon,
} from '../../src/components/icons'
import { links } from '../../src/links'
import Container from './Container.astro'

const linkColumns = [
  [
    { title: 'home', href: '/' },
    { title: 'projects', href: '/projects' },
    { title: 'snippets', href: '/snippets' },
    { title: 'blog', href: '/blog' },
    { title: 'all posts', href: '/all-posts' },
  ],
  [
    { title: 'about', href: '/about' },
    { title: 'art', href: '/authentic-artistique-endevours' },
    { title: '/uses', href: '/uses' },
    { title: 'source', href: '/src', external: true },
    { title: 'stats', href: '/stats', external: true },
  ],
]

const socialLinks = [
  { title: 'soorria', href: links.github.href, icon: GithubIconSolid, label: 'github' },
  { title: 'email', href: links.email.href, icon: EmailIcon, label: 'email' },
  { title: 'soorria', href: links.linkedin.href, icon: LinkedinIconSolid, label: 'linkedin' },
  { title: 'all links', href: links.card.href, icon: LinkIcon, label: 'all links' },
]

const linkClass = 'transition-colors text-drac-pink hocus:text-drac-purple focus-ring rounded-sm'
---

<Container>
  <footer class="border-drac-base-light flex flex-col space-y-8 border-t pt-8 pb-10">
    <div class="mx-auto w-full max-w-sm">
      <p
        class="focus-ring group block rounded-sm text-center"
        aria-label="Made with love by Soorria"
      >
        Made with <span class="relative inline-block h-5 w-5 align-middle">
          <HeartIcon className="text-drac-purple absolute inset-0 fill-current" />
          <HeartIcon
            className="animate-ping-slow text-drac-red absolute inset-0 fill-current"
            style={{ animationDelay: '150ms' }}
          />
          <HeartIcon className="animate-ping-slow text-drac-pink absolute inset-0 fill-current" />
        </span> by Soorria
      </p>
    </div>
    <div
      class="mx-auto grid max-w-sm grid-cols-1 justify-center gap-4 text-center lowercase sm:grid-cols-3"
    >
      {
        linkColumns.map(column => (
          <div class="mx-auto flex w-32 flex-col space-y-4">
            {column.map(link => (
              <a
                class={linkClass}
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.title}
              </a>
            ))}
          </div>
        ))
      }
      <div class="mx-auto flex w-32 flex-col space-y-4">
        {
          socialLinks.map(link => (
            <a class={linkClass} href={link.href} target="_blank" rel="noopener noreferrer">
              <span class="inline-flex items-center space-x-1">
                <link.icon aria-label={link.label} className="h-3 w-3" />
                <span>{link.title}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </footer>
</Container>
