---
import MainLayout from '~/layouts/MainLayout.astro'
import PostLayout from '~/components/posts/PostLayout'
import { SecretsSettings } from './_secrets-client'
import { PUBLIC_URL } from '~/constants'
import { getOgImage } from '~/utils/og'

const title = 'Secret Stuff'
const description = 'Shhh...'
const url = `${PUBLIC_URL}/secrets`
---

<MainLayout
  title={title}
  description={description}
  ogImage={getOgImage({ title: 'Nothing to see here...', subtitle: 'soorria.com' })}
>
  <PostLayout title={title}>
    <noscript>
      <p>This page needs JavaScript!</p>
    </noscript>
    <SecretsSettings client:only="react" />
  </PostLayout>
</MainLayout>
