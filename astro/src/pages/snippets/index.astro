---
import { getCollection } from 'astro:content'
import MainLayout from '~/layouts/MainLayout.astro'
import PostLayout from '~/components/posts/PostLayout'
import SnippetCard from '~/components/posts/SnippetCard'
import { getOgImageForData } from '~/utils/og'
import { PUBLIC_URL } from '~/constants'

const description =
  'Little bits of code that I find useful and you might too! Mostly written in TypeScript & JavaScript and often for React, Vue and SolidJS.'
const title = 'Snippets'
const url = `${PUBLIC_URL}/snippets`

// Get all snippets and sort by createdAt
const allSnippets = await getCollection('snippets')
const snippets = allSnippets
  .sort((a, b) => {
    const dateA = new Date(a.data.createdAt).getTime()
    const dateB = new Date(b.data.createdAt).getTime()
    return dateB - dateA
  })
  .map(snippet => ({
    slug: snippet.id,
    title: snippet.data.title,
    shortDescription: snippet.data.shortDescription,
    createdAt: snippet.data.createdAt,
    updatedAt: snippet.data.updatedAt,
    category: snippet.data.category,
  }))
---

<MainLayout
  title={title}
  description={description}
  ogImage={getOgImageForData('snippets')}
>
  <PostLayout title="Snippets" description={description}>
    <div>
      <div
        style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); --initial-step: 3"
        class="slide-in grid auto-cols-min grid-cols-1 content-start gap-x-6 gap-y-8 sm:grid-cols-2! sm:gap-x-8 lg:gap-12"
      >
        {snippets.map((snippet, i) => (
          <div class="grid" style={`--step-num: ${i + 1}`}>
            <SnippetCard snippet={snippet} client:load />
          </div>
        ))}
      </div>
    </div>
    <div class="my-12 text-center">{snippets.length} snippets total</div>
  </PostLayout>
</MainLayout>
