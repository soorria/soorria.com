---
import { getCollection, render } from 'astro:content'
import MainLayout from '~/layouts/MainLayout.astro'
import PostLayout from '~/components/posts/PostLayout'
import ProseWrapper from '~/components/posts/ProseWrapper'
import Giscus from '~/components/posts/Giscus'
import { ClockIconSolid, EditIcon } from '~/components/icons'
import { formatDate } from '~/utils/date'
import { getOgImageForData } from '~/utils/og'
import { PUBLIC_URL } from '~/constants'
import { mdxComponents } from '~/components/mdx/components'

export async function getStaticPaths() {
  // Snippets with custom components or JSX props that need special handling
  // TODO: Migrate these components properly
  // Snippets with issues that need special handling
  const snippetsWithCustomComponents: string[] = [
    // All snippets now supported!
  ]

  const snippets = await getCollection('snippets')
  return snippets
    .filter(snippet => !snippetsWithCustomComponents.includes(snippet.id))
    .map(snippet => ({
      params: { slug: snippet.id },
      props: { snippet },
    }))
}

const { snippet } = Astro.props
const { Content } = await render(snippet)

const url = `${PUBLIC_URL}/snippets/${snippet.id}`
const pageTitle = `${snippet.data.title} | Snippets`
---

<MainLayout
  title={pageTitle}
  description={snippet.data.shortDescription}
  ogImage={getOgImageForData('snippets', snippet.data.title)}
>
  <PostLayout title={snippet.data.title}>
    <div class="flex items-center justify-center gap-8 text-sm tabular-nums">
      <div class="tooltip flex items-center space-x-2" aria-label="Created at">
        <ClockIconSolid className="inline-block h-4 w-4" />
        <span>{formatDate(snippet.data.createdAt)}</span>
      </div>

      {snippet.data.updatedAt && snippet.data.createdAt !== snippet.data.updatedAt && (
        <div class="tooltip flex items-center space-x-2" aria-label="Updated at">
          <EditIcon className="inline-block h-4 w-4" />
          <span>{formatDate(snippet.data.updatedAt)}</span>
        </div>
      )}
    </div>

    <ProseWrapper>
      <Content components={mdxComponents} />
    </ProseWrapper>

    <div class="mt-16">
      <h2 class="mb-4 text-xl font-bold">Comments</h2>
      <Giscus client:only="react" dataType="snippets" slug={snippet.id} />
    </div>
  </PostLayout>
</MainLayout>
