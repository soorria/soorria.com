---
import AllPostsGrid from '../../src/components/posts/AllPostsGrid'
import { getAllPosts, sortPostsForRender } from '../../src/lib/data'
import { getOgImageForData } from '../../src/utils/og'
import MainLayout from '../layouts/MainLayout.astro'
import PostLayout from '../layouts/PostLayout.astro'

const description = "All the stuff I've written on this site"
const posts = sortPostsForRender(await getAllPosts())
---

<MainLayout
  title="All Posts"
  description={description}
  canonical="https://soorria.com/all-posts"
  ogTitle="All Posts"
  ogImage={getOgImageForData('snippets').url}
>
  <PostLayout title="All Posts" description={description}>
    <AllPostsGrid posts={posts} style={{ '--initial-step': '2' }} />
    <div class="my-12 text-center">{posts.length} posts total</div>
  </PostLayout>
</MainLayout>
