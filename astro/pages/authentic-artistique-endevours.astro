---
export const prerender = false
import { Image } from 'astro:assets'
import DavidLau from '../../src/assets/art/david-lau-nft-real.png'
import DonaldTrump from '../../src/assets/art/donald trump nft (real).png'
import GlisteningSaint from '../../src/assets/art/glistening-saint.gif'
import SandboxTshirt from '../../src/assets/art/sandbox-tshirt.jpg'
import SpeedSudoku from '../../src/assets/art/speed-sudoku-champion-riki.png'
import Bruhfferfish from '../../src/assets/art/the-bruhfferfish.jpg'
import Waifu from '../../src/assets/art/unnamed waifu.png'
import { MagicSprinkles } from '../../src/components/installations/MagicSprinkles'
import { getOgImage } from '../../src/utils/og'
import MainLayout from '../layouts/MainLayout.astro'
import PostLayout from '../layouts/PostLayout.astro'

Astro.response.headers.set('Cache-Control', 's-maxage=10, stale-while-revalidate')
const nftMeanings = [
  'Not For Thinking',
  'Nebulous Frivolous Token',
  'Nonexistent Fantasy Treasure',
  'Notoriously Fickle Trinket',
  'Nonsensical Fad Trend',
  'Nifty Fictitious Token',
  'Never-ending Foolish Transmission',
  'Noisy Futile Tchotchke',
  'Novelty Fabricated Trophy',
  'Notoriously Flawed Triviality',
  'Nonfunctional Farce Transaction',
]
const randomNftMeaning = () => nftMeanings[Math.floor(Math.random() * nftMeanings.length)]
const art = [
  {
    title: 'Glistening Saint',
    date: '2025-10-23',
    src: GlisteningSaint,
    alt: 'gif of a saint with emoji prayer hands coming together to form a heart',
  },
  {
    title: 'the bruhfferfish',
    date: '2025-09-12',
    src: Bruhfferfish,
    alt: 'colorful pufferfish drawing with bruh written on its side',
  },
  {
    title: 'Sandbox Bouldering t-shirt design',
    date: '2025-05-10',
    src: SandboxTshirt,
    alt: 't-shirt design featuring a cat in a sandbox',
  },
  {
    title: 'Speed Sudoku Champion Riki',
    date: '2023-12-13',
    src: SpeedSudoku,
    alt: 'pencil drawing of Riki after winning speed sudoku',
  },
  {
    title: 'david Lau nft (real)',
    nftMeaning: randomNftMeaning(),
    date: '2023-12-02',
    src: DavidLau,
    alt: 'satirical depiction of David Lau shooting laser beams',
  },
  {
    title: 'unnamed waifu',
    date: '2022-09-02',
    src: Waifu,
    alt: 'drawing of a waifu saying I love you',
  },
  {
    title: 'donald trump nft (real)',
    nftMeaning: randomNftMeaning(),
    date: '2022-12-17',
    src: DonaldTrump,
    alt: 'satirical portrayal of a Donald Trump NFT',
  },
]
---

<MainLayout
  title="Authentic Artistique Endevours"
  description="Welcome to the world of the authentic artistique endevours of Soorria Saruva."
  canonical="https://soorria.com/art"
  ogTitle="Authentic Artistique Endevours"
  ogImage={getOgImage({ title: 'Authentic Artistique Endevours', subtitle: 'soorria.com/art' }).url}
>
  <PostLayout
    title="Art"
    description={'...or more accurately "art". Welcome to the world of the authentic artistique endevours of Soorria Saruva.'}
  >
    <div class="prose mx-auto">
      {
        art.map(item => (
          <section>
            <>
              <h2>
                {item.nftMeaning ? (
                  <>
                    {item.title.replace('nft', '')}
                    <abbr
                      class="tooltip cursor-help"
                      title={item.nftMeaning}
                      aria-label={item.nftMeaning}
                    >
                      nft
                      <sup aria-hidden="true" class="text-drac-pink text-sm font-bold">
                        ?
                      </sup>
                    </abbr>
                  </>
                ) : (
                  item.title
                )}
              </h2>
              <p>
                <em>masterfully</em> created on{' '}
                <time datetime={item.date}>{new Date(item.date).toLocaleDateString()}</time>
              </p>
              <Image src={item.src} alt={item.alt} />
            </>
          </section>
        ))
      }
      <section>
        <h2>magic sprinkles</h2>
        <div class="not-prose relative aspect-video overflow-hidden rounded-lg">
          <MagicSprinkles client:only="react" />
          <a
            class="bg-drac-base absolute inset-x-0 bottom-4 mx-auto block w-fit rounded px-4 py-2"
            href="/installations/magic-sprinkles"
          >
            see full installation
          </a>
        </div>
      </section>
    </div>
  </PostLayout>
  <div class="text-drac-pink pb-2 text-center text-xs">
    Rendered at {new Date().toLocaleString()}
  </div>
</MainLayout>
