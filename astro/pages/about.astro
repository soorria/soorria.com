---
import { getOgImage } from '../../src/utils/og'
import ContentRenderer from '../components/mdx/ContentRenderer.astro'
import MainLayout from '../layouts/MainLayout.astro'
import PostLayout from '../layouts/PostLayout.astro'
---

<MainLayout
  title="About Me"
  description="Who I am and what I do"
  canonical="https://soorria.com/about"
  ogTitle="About Me"
  ogType="article"
  ogImage={getOgImage({ title: 'About Me', subtitle: 'soorria.com' }).url}
>
  <PostLayout title="About Me">
    <div class="slide-in prose md:prose-lg mx-auto mt-6 mb-12">
      <ContentRenderer type="misc" slug="about" />
    </div>
  </PostLayout>
</MainLayout>
