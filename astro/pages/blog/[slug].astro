---
import {
  BookIcon,
  ClockIconSolid,
  EditIcon,
  GlobeAuIcon,
  TextIcon,
} from '../../../src/components/icons'
import Giscus from '../../../src/components/posts/comments/Giscus.client'
import { getFileFrontMatter } from '../../../src/lib/data'
import type { BlogPostFrontMatter } from '../../../src/types/blog-post'
import { formatDate } from '../../../src/utils/date'
import { getOgImageForData } from '../../../src/utils/og'
import CodeBlock from '../../components/mdx/CodeBlock.astro'
import CustomLink from '../../components/mdx/CustomLink.astro'
import Collapse from '../../components/mdx/Collapse.astro'
import Image from '../../components/mdx/Image.astro'
import MdxDemo from '../../components/mdx/MdxDemo.astro'
import Note from '../../components/mdx/Note.astro'
import OnlyIsTs from '../../components/mdx/OnlyIsTs.astro'
import Sandbox from '../../components/mdx/Sandbox.astro'
import Sparkles from '../../components/mdx/Sparkles.astro'
import TsJsSwitcher from '../../components/mdx/TsJsSwitcher.astro'
import TsJsToggle from '../../components/mdx/TsJsToggle.astro'
import { getContentSlugs, loadContent } from '../../lib/content'
import MainLayout from '../../layouts/MainLayout.astro'
import PostLayout from '../../layouts/PostLayout.astro'

export async function getStaticPaths() {
  return await Promise.all(
    getContentSlugs('blog').map(async slug => ({
      params: { slug },
      props: { post: await getFileFrontMatter<BlogPostFrontMatter>('blog', slug) },
    }))
  )
}

interface Props {
  post: BlogPostFrontMatter
}

const { post } = Astro.props
const { default: Content } = await loadContent('blog', post.slug)
const canonical = `https://soorria.com/posts/${post.slug}`
const metaTitle = `${post.title} | Blog`
const ogImage = getOgImageForData('blog', post.title, post.ogImageTitleParts).url
const createdAt = new Date(post.createdAt || 0).toISOString()
const modifiedAt = new Date(post.updatedAt || post.createdAt || 0).toISOString()

const mdxComponents = {
  a: CustomLink,
  pre: CodeBlock,
  Note,
  Image,
  Collapse,
  TsJsToggle,
  OnlyIsTs,
  Sandbox,
  Sparkles,
  sparkles: Sparkles,
  's-sparkles': Sparkles,
  MdxDemo,
  TsJsSwitcher,
}
---

<MainLayout
  title={metaTitle}
  description={post.shortDescription}
  canonical={canonical}
  ogTitle={metaTitle}
  ogType="article"
  ogImage={ogImage}
  publishedTime={createdAt}
  modifiedTime={modifiedAt}
  tags={post.tags}
>
  <PostLayout title={post.title}>
    <div
      class="text-drac-highlight grid gap-4 px-4 text-center"
      role="presentation"
      aria-hidden="true"
      style="grid-template-columns: 1fr auto 1fr"
    >
      <div class="flex items-center opacity-50"><div class="h-px flex-1 bg-current"></div></div>
      <GlobeAuIcon
        className="inline-block h-6 w-6 transition-transform ease-linear"
        style={{ transform: 'rotate(calc(var(--scroll) * 2 * 360deg))' }}
      />
      <div class="flex items-center opacity-50"><div class="h-px flex-1 bg-current"></div></div>
    </div>

    <div
      class="grid grid-cols-2 items-center justify-items-center gap-4 text-sm tabular-nums sm:grid-cols-4"
    >
      <div class="tooltip flex items-center space-x-2" aria-label="Reading time">
        <BookIcon className="inline-block h-4 w-4" />
        <span>{post.readingTime}</span>
      </div>
      <div class="tooltip flex items-center space-x-2" aria-label="Word count">
        <TextIcon className="inline-block h-4 w-4" />
        <span>{post.words}</span>
      </div>
      <div
        class:list={[
          'tooltip flex items-center space-x-2',
          post.updatedAt ? '' : 'pointer-events-none opacity-0',
        ]}
        aria-label="Updated at"
      >
        <EditIcon className="inline-block h-3 w-3" />
        <span>{formatDate(post.updatedAt)}</span>
      </div>
      <div class="tooltip flex items-center space-x-2" aria-label="Created at">
        <ClockIconSolid className="inline-block h-4 w-4" />
        <span>{formatDate(post.createdAt, 'DRAFT')}</span>
      </div>
    </div>

    <div>
      <div>
        <div class="slide-in prose md:prose-lg mx-auto mt-6 mb-12" style="--initial-step: 0">
          <Content components={mdxComponents} />
        </div>
      </div>
    </div>

    <Giscus client:only="react" dataType="blog" slug={post.slug} />
  </PostLayout>
</MainLayout>

<script>
  let scrollPercent = '0'
  let animationFrame: number
  const updateScroll = () => {
    const body = document.body
    const html = document.documentElement
    scrollPercent = (
      (body.scrollTop || html.scrollTop) / Math.max(1, html.scrollHeight - html.clientHeight)
    ).toFixed(2)
  }
  const paintScroll = () => {
    document.body.style.setProperty('--scroll', scrollPercent)
    animationFrame = requestAnimationFrame(paintScroll)
  }
  updateScroll()
  paintScroll()
  window.addEventListener('scroll', updateScroll, { passive: true })
  document.addEventListener('astro:before-swap', () => cancelAnimationFrame(animationFrame), {
    once: true,
  })
</script>
